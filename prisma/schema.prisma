generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  goals     Goal[]
  createdAt DateTime @default(now())
}

model Goal {
  id        String   @id @default(cuid())
  title     String
  progress  Int      @default(0) // 0-100
  deadline  String?  // YYYY-MM-DD
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
}
